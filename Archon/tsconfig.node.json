{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "vitest.main.config.*",
    "electron/**/*",
    "src/core/types/**/*",
    "src/core/constants/**/*",
    "src/core/settings/**/*",
    "src/core/schemas/**/*",
    "src/core/validation/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noImplicitAny": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
